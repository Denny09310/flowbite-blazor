@inherits TestContext
@code
{
    [Fact]
    public void RendersDefaultAvatar()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar Image="https://flowbite.com/docs/images/people/profile-picture-5.jpg" />
        );

        // Assert
        cut.MarkupMatches(
            @<div>
                <div class="relative">
                    <img class="h-10 w-10 rounded" src="https://flowbite.com/docs/images/people/profile-picture-5.jpg">
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAvatarWithInitials()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar Initials="JD" />
        );

        // Assert
        cut.MarkupMatches(
            @<div>
                <div class="relative">
                    <div class="relative inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded bg-blue-100 dark:bg-blue-600">
                        <span class="font-medium text-blue-600 dark:text-blue-300">
                            JD
                        </span>
                    </div>
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAvatarWithPlaceholder()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar>
                <Placeholder>
                    <span>👤</span>
                </Placeholder>
            </Avatar>
        );

        // Assert
        cut.MarkupMatches(
            @<div>
                <div class="relative">
                    <div class="relative h-10 w-10 overflow-hidden rounded bg-blue-100 dark:bg-blue-600">
                        <span>👤</span>
                    </div>
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAvatarWithIndicator()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar ShowIndicator="true" Image="https://flowbite.com/docs/images/people/profile-picture-5.jpg" />
        );

        // Assert
        cut.MarkupMatches(
            @<div>
                <div class="relative">
                    <span class="absolute right-7 top-0 rounded-full border-2 border-white bg-green-400 dark:border-blue-800"></span>
                    <img class="h-10 w-10 rounded" src="https://flowbite.com/docs/images/people/profile-picture-5.jpg">
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAvatarWithBorder()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar Bordered="true" Image="https://flowbite.com/docs/images/people/profile-picture-5.jpg" />
        );

        // Assert
        cut.MarkupMatches(
            @<div>
                <div class="relative">
                    <img class="h-10 w-10 rounded ring-2 ring-blue-300 dark:ring-blue-500" src="https://flowbite.com/docs/images/people/profile-picture-5.jpg">
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAvatarWithTextFragment()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar>
                <Text>
                    <span>John Doe</span>
                </Text>
            </Avatar>
        );

        // Assert
        cut.MarkupMatches(
            @<div class="flex items-center gap-4">
                <div class="relative">
                    <img class="h-10 w-10 rounded">
                </div>
                <div class="font-medium dark:text-white">
                    <span>John Doe</span>
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAvatarWithChildContent()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar>
                <ChildContent>
                    <span>Custom Content</span>
                </ChildContent>
            </Avatar>
        );

        // Assert
        cut.MarkupMatches(
            @<div class="flex items-center gap-4">
                <div class="relative">
                    <img class="h-10 w-10 rounded">
                </div>
                <div class="font-medium dark:text-white">
                    <span>Custom Content</span>
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAvatarWithLargeSize()
    {
        // Arrange & Act
        var cut = Render(
            @<Avatar Size="Sizes.Large">
                <ChildContent>
                    <span>Custom Content</span>
                </ChildContent>
            </Avatar>
        );

        // Assert
        cut.MarkupMatches(
            @<div class="flex items-center gap-4">
                <div class="relative">
                    <img class="h-20 w-20 rounded">
                </div>
                <div class="font-medium dark:text-white">
                    <span>Custom Content</span>
                </div>
            </div>
        );
    }
}
