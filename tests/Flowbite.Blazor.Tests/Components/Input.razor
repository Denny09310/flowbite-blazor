@inherits TestContext

@code 
{
    [Fact]
    public void RendersDefaultInput()
    {
        // Arrange & Act
        var cut = Render(
            @<Input TValue="string" />
        );

        // Assert
        cut.MarkupMatches(
            @<input class="block w-full rounded-lg border bg-blue-50 p-2.5 text-sm text-blue-900 dark:bg-blue-600 dark:placeholder-blue-400 dark:text-white" />
        );
    }

    [Fact]
    public void RendersInputWithColorAndSize()
    {
        // Arrange & Act
        var cut = Render(
            @<Input TValue="string" Color="Colors.Red" Size="Sizes.Large" />
        );

        // Assert
        cut.MarkupMatches(
            @<input class="block w-full rounded-lg border bg-blue-50 p-4 text-base text-blue-900 focus:ring-red-500 focus:border-red-500 dark:bg-blue-600 dark:placeholder-blue-400 dark:text-white dark:focus:ring-red-500 dark:focus:border-red-500" />
        );
    }

