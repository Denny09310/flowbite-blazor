@inherits TestContext

@code 
{
    [Fact]
    public void RendersDefaultBadge()
    {
        // Arrange & Act
        var cut = Render(
            @<Badge Text="Default Badge" />
        );

        // Assert
        cut.MarkupMatches(
            @<span class="me-2 rounded bg-blue-100 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Default Badge
            </span>
        );
    }

    [Fact]
    public void RendersBadgeWithColor()
    {
        // Arrange & Act
        var cut = Render(
            @<Badge Text="Colored Badge" Color="Colors.Blue" />
        );

        // Assert
        cut.MarkupMatches(
            @<span class="me-2 rounded bg-blue-100 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Colored Badge
            </span>
        );
    }

    [Fact]
    public void RendersBadgeWithSize()
    {
        // Arrange & Act
        var cut = Render(
            @<Badge Text="Large Badge" Size="Sizes.Large" />
        );

        // Assert
        cut.MarkupMatches(
            @<span class="me-2 rounded bg-blue-100 text-lg font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Large Badge
            </span>
        );
    }

    [Fact]
    public void RendersBadgeWithBorder()
    {
        // Arrange & Act
        var cut = Render(
            @<Badge Text="Bordered Badge" Bordered="true" Color="Colors.Green" />
        );

        // Assert
        cut.MarkupMatches(
            @<span class="me-2 rounded border border-green-500 bg-green-100 text-xs font-medium text-green-800 dark:bg-green-900 dark:text-green-300">
                Bordered Badge
            </span>
        );
    }

    [Fact]
    public void RendersBadgeWithRoundedCorners()
    {
        // Arrange & Act
        var cut = Render(
            @<Badge Text="Rounded Badge" Rounded="true" />
        );

        // Assert
        cut.MarkupMatches(
            @<span class="me-2 rounded-full bg-blue-100 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                Rounded Badge
            </span>
        );
    }

    [Fact]
    public void RendersBadgeWithHref()
    {
        // Arrange & Act
        var cut = Render(
            @<Badge Text="Clickable Badge" Href="https://example.com" />
        );

        // Assert
        cut.MarkupMatches(
            @<a class="me-2 rounded bg-blue-100 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300" href="https://example.com">
                Clickable Badge
            </a>
        );
    }

    [Fact]
    public void RendersBadgeWithChildContent()
    {
        // Arrange & Act
        var cut = Render(
            @<Badge>
                <ChildContent>
                    <span>Custom Content</span>
                </ChildContent>
            </Badge>
        );

        // Assert
        cut.MarkupMatches(
            @<span class="me-2 rounded bg-blue-100 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300">
                <span>Custom Content</span>
            </span>
        );
    }
}
