@inherits TestContext
@code
{
    [Fact]
    public void RendersDefaultAlert()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="mb-4 flex bg-blue-100 p-4 text-sm text-blue-500 hover:bg-blue-200 focus:ring-blue-400 dark:bg-blue-200 dark:text-blue-600 dark:hover:bg-blue-300" role="alert"></div>
        );
    }

    [Fact]
    public void RendersAlertWithBorder()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" Bordered />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="mb-4 flex border-t-4 border-blue-500 bg-blue-100 p-4 text-sm text-blue-500 hover:bg-blue-200 focus:ring-blue-400 dark:bg-blue-200 dark:text-blue-600 dark:hover:bg-blue-300" role="alert"></div>
        );
    }

    [Fact]
    public void RendersAlertWithChildContent()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id">
                <p>This is an alert</p>
            </Alert>
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="mb-4 flex bg-blue-100 p-4 text-sm text-blue-500 hover:bg-blue-200 focus:ring-blue-400 dark:bg-blue-200 dark:text-blue-600 dark:hover:bg-blue-300" role="alert">
                <p>This is an alert</p>
            </div>
        );
    }

    [Fact]
    public void RendersAlertWithIcon()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" ShowIcon="true" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="mb-4 flex bg-blue-100 p-4 text-sm text-blue-500 hover:bg-blue-200 focus:ring-blue-400 dark:bg-blue-200 dark:text-blue-600 dark:hover:bg-blue-300" role="alert">
                <span class="sr-only">Info</span>
                <Info Class="mr-3 inline h-5 w-5 flex-shrink-0" />
            </div>
        );
    }

    [Fact]
    public void RendersDismissableAlert()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" Dismissable="true" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="mb-4 flex bg-blue-100 p-4 text-sm text-blue-500 hover:bg-blue-200 focus:ring-blue-400 dark:bg-blue-200 dark:text-blue-600 dark:hover:bg-blue-300" role="alert">
                <button type="button" class="ml-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100 text-blue-700 focus:ring-2 dark:bg-blue-200 dark:text-blue-800" aria-label="Close" data-dismiss-target="#alert-id">
                    <span class="sr-only">Close</span>
                    <Close />
                </button>
            </div>
        );
    }

    [Fact]
    public void RendersAlertWithActions()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id">
                <Actions>
                    <button>Retry</button>
                </Actions>
            </Alert>
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="mb-4 flex bg-blue-100 p-4 text-sm text-blue-500 hover:bg-blue-200 focus:ring-blue-400 dark:bg-blue-200 dark:text-blue-600 dark:hover:bg-blue-300" role="alert">
                <div class="flex">
                    <button>Retry</button>
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAlertWithCustomColor()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" Color="Colors.Red" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="mb-4 flex bg-red-100 p-4 text-sm text-red-500 hover:bg-red-200 focus:ring-red-400 dark:bg-red-200 dark:text-red-600 dark:hover:bg-red-300" role="alert"></div>
        );
    }
}
