@inherits TestContext
@code
{
    [Fact]
    public void RendersDefaultAlert()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="bg-gray-100 text-gray-500 focus:ring-gray-400 hover:bg-gray-200 dark:bg-gray-200 dark:text-gray-600 dark:hover:bg-gray-300 border-gray-500 border-t-4 flex p-4 mb-4 text-sm" role="alert"></div>
        );
    }

    [Fact]
    public void RendersAlertWithChildContent()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id">
                <p>This is an alert</p>
            </Alert>
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="bg-gray-100 text-gray-500 focus:ring-gray-400 hover:bg-gray-200 dark:bg-gray-200 dark:text-gray-600 dark:hover:bg-gray-300 border-gray-500 border-t-4 flex p-4 mb-4 text-sm" role="alert">
                <p>This is an alert</p>
            </div>
        );
    }

    [Fact]
    public void RendersAlertWithIcon()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" ShowIcon="true" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="bg-gray-100 text-gray-500 focus:ring-gray-400 hover:bg-gray-200 dark:bg-gray-200 dark:text-gray-600 dark:hover:bg-gray-300 border-gray-500 border-t-4 flex p-4 mb-4 text-sm" role="alert">
                <span class="sr-only">Info</span>
                <Info Class="flex-shrink-0 mr-3 inline h-5 w-5" />
            </div>
        );
    }

    [Fact]
    public void RendersDismissableAlert()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" Dismissable="true" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="bg-gray-100 text-gray-500 focus:ring-gray-400 hover:bg-gray-200 dark:bg-gray-200 dark:text-gray-600 dark:hover:bg-gray-300 border-gray-500 border-t-4 flex p-4 mb-4 text-sm" role="alert">
                <button type="button" class="text-gray-700 bg-gray-100 dark:bg-gray-200 dark:text-gray-800 ml-auto rounded-lg focus:ring-2 inline-flex items-center justify-center h-8 w-8" aria-label="Close" data-dismiss-target="#alert-id">
                    <span class="sr-only">Close</span>
                    <Close />
                </button>
            </div>
        );
    }

    [Fact]
    public void RendersAlertWithActions()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id">
                <Actions>
                    <button>Retry</button>
                </Actions>
            </Alert>
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="bg-gray-100 text-gray-500 focus:ring-gray-400 hover:bg-gray-200 dark:bg-gray-200 dark:text-gray-600 dark:hover:bg-gray-300 border-gray-500 border-t-4 flex p-4 mb-4 text-sm" role="alert">
                <div class="flex">
                    <button>Retry</button>
                </div>
            </div>
        );
    }

    [Fact]
    public void RendersAlertWithCustomColor()
    {
        // Arrange & Act
        var cut = Render(
            @<Alert Id="alert-id" Color="Colors.Red" />
        );

        // Assert
        cut.MarkupMatches(
            @<div id="alert-id" class="bg-red-100 text-red-500 focus:ring-red-400 hover:bg-red-200 dark:bg-red-200 dark:text-red-600 dark:hover:bg-red-300 border-red-500 border-t-4 flex p-4 mb-4 text-sm" role="alert"></div>
        );
    }
}
