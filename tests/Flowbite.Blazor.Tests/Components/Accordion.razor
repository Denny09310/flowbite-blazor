                    <Body>
                        <p>Flowbite is a powerful UI component library.</p>
                    </Body>
                </AccordionItem>
            </Accordion>
        );

        // Verify the accordion body is initially collapsed (hidden)
        var accordionBody = cut.Find("#accordion-id-body-f0000");
