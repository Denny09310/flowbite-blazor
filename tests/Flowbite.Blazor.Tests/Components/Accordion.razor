@inherits TestContext

@code
{
    // Test to check the rendering of the Accordion and AccordionItem with default content
    [Fact]
    public void RendersDefaultAccordionWithItem()
    {
        // Arrange & Act
        var cut = Render(
            @<Accordion Id="accordion-id">
                <AccordionItem>
                    <Heading>
                        <span>What is Flowbite?</span>
                    </Heading>
                    <Body>
                        <p class="mb-2 text-blue-500 dark:text-blue-400">Flowbite is an open-source library of interactive components built on top of Tailwind CSS including buttons, dropdowns, modals, navbars, and more.</p>
                        <p class="text-blue-500 dark:text-blue-400">Check out this guide to learn how to <a href="/docs/getting-started/introduction/" class="text-blue-600 hover:underline dark:text-blue-500">get started</a> and start developing websites even faster with components on top of Tailwind CSS.</p>
                    </Body>
                </AccordionItem>
            </Accordion>
        );

        // Assert
        cut.MarkupMatches(
            @<div id="accordion-id" data-accordion="collapse">
                <h2 id="accordion-id-heading-f0000">
                    <button type="button" class="flex w-full items-center justify-between gap-3 rounded-t-xl border border-b-0 border-blue-200 p-5 font-medium text-blue-500 hover:bg-blue-100 focus:ring-4 focus:ring-blue-200 rtl:text-right dark:border-blue-700 dark:text-blue-400 dark:focus:ring-blue-800 dark:hover:bg-blue-800" data-accordion-target="#accordion-id-body-f0000" aria-controls="accordion-id-body-f0000">
                        <span>What is Flowbite?</span>
                        <ChevronDown data-accordion-icon Class="h-3 w-3" />
                    </button>
                </h2>
                <div id="accordion-id-body-f0000" class="hidden" aria-labelledby="accordion-id-heading-f0000">
                    <div class="border border-b-0 border-blue-200 p-5 dark:border-blue-700 dark:bg-blue-900">
                        <p class="mb-2 text-blue-500 dark:text-blue-400">Flowbite is an open-source library of interactive components built on top of Tailwind CSS including buttons, dropdowns, modals, navbars, and more.</p>
                        <p class="text-blue-500 dark:text-blue-400">Check out this guide to learn how to <a href="/docs/getting-started/introduction/" class="text-blue-600 hover:underline dark:text-blue-500">get started</a> and start developing websites even faster with components on top of Tailwind CSS.</p>
                    </div>
                </div>
            </div>
        );
    }

