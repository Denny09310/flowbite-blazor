@namespace Flowbite.Blazor.Components
@inherits FlowbiteComponentBase

<CascadingValue Value="this" IsFixed>
    <div @attributes="AdditionalAttributes" id="@Id" class="@Class" style="@Style" data-accordion="@Type" data-active-classes="@ActiveClasses" data-inactive-classes="@InactiveClasses">
        @ChildContent
    </div>
</CascadingValue>